<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

    <!-- 必须是合法的语言标识（BCP-47）。原先写的 zh_CN 带下划线，不是合法取值，
         系统无法据此匹配本地化资源；zh-Hans 才是「简体中文」的正确写法。
         开发区域取中文是刻意的：漏配翻译时回退目标就是中文，界面对中文用户
         永远正确（失败模式安全），于是只有 en.lproj 需要维护一张翻译表。 -->
    <key>CFBundleDevelopmentRegion</key>
    <string>zh-Hans</string>

    <!-- 声明实际支持的语言，让系统知道不必再去别处找。缺了它，系统在英文环境下
         可能仍把开发区域当成唯一选择。 -->
    <key>CFBundleLocalizations</key>
    <array>
        <string>en</string>
        <string>zh-Hans</string>
    </array>

    <!-- Apple Help Book：帮助菜单的系统搜索框只有在这一项存在时才会出现。
         书名要与 Contents/Resources/*.lproj/7-Zip.help/Contents/Info.plist
         里的 HPDBookTitle 一致。 -->
    <key>CFBundleHelpBookFolder</key>
    <string>7-Zip.help</string>

    <key>CFBundleHelpBookName</key>
    <string>7-Zip Help</string>

    <key>CFBundleExecutable</key>
    <string>7-Zip</string>

    <key>CFBundleIdentifier</key>
    <string>org.7-zip.macos.app</string>

    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>

    <key>CFBundleName</key>
    <string>7-Zip</string>

    <key>CFBundleDisplayName</key>
    <string>7-Zip</string>

    <key>CFBundlePackageType</key>
    <string>APPL</string>

    <key>CFBundleShortVersionString</key>
    <string>26.03</string>

    <key>CFBundleVersion</key>
    <string>26.03</string>

    <key>CFBundleIconFile</key>
    <string>7zip</string>

    <key>LSMinimumSystemVersion</key>
    <string>11.0</string>

    <key>NSHighResolutionCapable</key>
    <true/>

    <key>NSPrincipalClass</key>
    <string>NSApplication</string>

    <key>NSSupportsAutomaticGraphicsSwitching</key>
    <true/>

    <key>NSHumanReadableCopyright</key>
    <string>7-Zip Copyright (C) 1999-2026 Igor Pavlov. Distributed under the GNU LGPL with the unRAR license restriction.</string>

    <!-- ============================ Document types ============================ -->

    <key>CFBundleDocumentTypes</key>
    <array>

        <!-- Archive formats. These are the identifiers macOS itself uses, so
             the app joins the existing type identity instead of splitting it.
             Using a private spelling here (e.g. org.7-zip.7z-archive) would
             make .7z files resolve to a second, unrelated UTI. -->
        <dict>
            <key>CFBundleTypeName</key>
            <string>归档文件</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>org.7-zip.7-zip-archive</string>
                <string>public.zip-archive</string>
                <string>public.tar-archive</string>
                <string>org.gnu.gnu-zip-archive</string>
                <string>org.gnu.gnu-zip-tar-archive</string>
                <string>public.bzip2-archive</string>
                <string>org.tukaani.xz-archive</string>
                <string>com.rarlab.rar-archive</string>
                <string>public.iso-image</string>
                <string>public.disk-image</string>
                <string>com.microsoft.cab-archive</string>
                <string>public.zstandard-archive</string>
                <!-- macOS 给 .zst / .wim 实际分配的标识并不是上面那两个：
                     .zst → com.facebook.zstandard-archive，.wim → com.microsoft.wim-archive。
                     两个都列上，绑定才在这些文件上真正生效（这只是接受绑定，不是在
                     UTImportedTypeDeclarations 里重复声明类型，后者仍然不碰）。 -->
                <string>com.facebook.zstandard-archive</string>
                <string>com.microsoft.wim-archive</string>
                <!-- 本移植补的四个格式，系统本身已有公共标识（`mdls` 实测）：
                     .lz → public.lzip-archive、.lz4 → public.lz4-archive、
                     .br → com.google.brotli-archive、.sz → com.google.snappy-archive。
                     直接加入既有类型，不新造标识，避免把同一个类型拆成两份。 -->
                <string>public.lzip-archive</string>
                <string>public.lz4-archive</string>
                <string>com.google.brotli-archive</string>
                <string>com.google.snappy-archive</string>
            </array>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>7z</string>
                <string>zip</string>
                <string>zipx</string>
                <string>tar</string>
                <string>gz</string>
                <string>tgz</string>
                <string>bz2</string>
                <string>tbz</string>
                <string>tbz2</string>
                <string>xz</string>
                <string>txz</string>
                <string>rar</string>
                <string>cab</string>
                <string>iso</string>
                <string>dmg</string>
                <string>zst</string>
                <string>lzma</string>
                <!-- 本移植补的格式：lzip / lz4 / brotli / snappy。
                     系统没有给它们分配公共 UTI，所以只走 CFBundleTypeExtensions
                     这条传统绑定路径（不新增 UTImportedTypeDeclarations，
                     免得跟将来系统自带的类型定义撞车）。
                     两种写法都收：下拉框显示格式名，默认文件名用惯用扩展名。 -->
                <string>lz</string>
                <string>lzip</string>
                <string>lz4</string>
                <string>br</string>
                <string>brotli</string>
                <string>sz</string>
                <string>snappy</string>
                <string>zstd</string>
                <string>lzh</string>
                <string>arj</string>
                <string>cpio</string>
                <string>rpm</string>
                <string>deb</string>
                <string>wim</string>
                <string>swm</string>
                <string>esd</string>
                <string>apfs</string>
                <string>hfs</string>
                <string>vhd</string>
                <string>vhdx</string>
                <string>vmdk</string>
                <string>vdi</string>
                <string>qcow2</string>
                <string>squashfs</string>
                <string>udf</string>
                <string>msi</string>
                <string>chm</string>
                <string>xar</string>
                <string>pkg</string>
            </array>
        </dict>

        <!-- split volumes and other extension-only cases -->
        <dict>
            <key>CFBundleTypeName</key>
            <string>分卷归档</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>001</string>
                <string>7z.001</string>
                <string>zip.001</string>
                <string>part1.rar</string>
                <string>r00</string>
                <string>z01</string>
                <string>z02</string>
            </array>
        </dict>

    </array>

    <!-- ====================== Type declarations we introduce ====================== -->

    <!--
      These restate identifiers that modern macOS already declares system-wide.
      Importing them is harmless there (the system definition wins) and ensures
      the extension-to-UTI binding still resolves on older releases.
      Zstandard is intentionally omitted: the system's public.zstandard-archive
      is authoritative and a second owner would fragment the type.
    -->

    <key>UTImportedTypeDeclarations</key>
    <array>

        <dict>
            <key>UTTypeIdentifier</key>
            <string>org.7-zip.7-zip-archive</string>
            <key>UTTypeDescription</key>
            <string>7-Zip 归档</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.data</string>
                <string>public.archive</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>7z</string>
                </array>
                <key>public.mime-type</key>
                <string>application/x-7z-compressed</string>
            </dict>
        </dict>

        <dict>
            <key>UTTypeIdentifier</key>
            <string>org.tukaani.xz-archive</string>
            <key>UTTypeDescription</key>
            <string>XZ 压缩文件</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.data</string>
                <string>public.archive</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>xz</string>
                    <string>txz</string>
                </array>
                <key>public.mime-type</key>
                <string>application/x-xz</string>
            </dict>
        </dict>

    </array>

    <!-- ============================ Finder services ============================ -->

    <!-- ⚠️ NSRequiredContext 是**必须**的，不是可选项。
         实测（同一 Info.plist 里放五个只差一个键的变体，一次启动对比，macOS 27）：
           public.item，无 ctx           → 访达「服务」里不出现
           public.item  + ctx{FilePath}  → 出现
           NSSendTypes(NSFilenames) + ctx→ 出现
           NSSendTypes(NSFilenames)，无  → 不出现
           两个 send 键都有，无 ctx      → 不出现
         即：**决定因素是 NSRequiredContext，与用 NSSendTypes 还是 NSSendFileTypes 无关**。
         缺了它的失败是完全静默的：pbs 照样登记、`pbs -read_bundle` 照样打印完整条目、
         应用照样启动，只有访达菜单里永远没有那两项。Keka 与 Terminal 都带着这个键。

         NSTextContent = FilePath 的语义是「当前内容是一段文件路径」，正是访达选中文件
         的场景，也正是系统给服务分组用的依据（菜单里会落到「文件和文件夹」一组）。

         NSMenuItem 里的语言键按**最具体者胜出**解析，顺序实测为
             zh_CN  >  zh-Hans  >  en  >  default
         （系统语言 zh-Hans-CN 上四个变体一次对比得出）。
         ⚠️ 因此**只写 default + en 会让中文系统显示英文**（实测如此）。要中文正确，
         必须显式写 zh-Hans / zh_CN；default 只负责兜底给未列出的语言。
         另：服务菜单条目数有上限，超出部分会被静默丢弃（实测约 12 项）——做这类对比
         实验时务必先清掉干扰项，否则会把「被截断」误判成「被过滤」。 -->
    <key>NSServices</key>
    <array>

        <dict>
            <key>NSMenuItem</key>
            <dict>
                <key>default</key>
                <string>用 7-Zip 压缩</string>
                <key>en</key>
                <string>Compress with 7-Zip</string>
                <key>zh-Hans</key>
                <string>用 7-Zip 压缩</string>
                <key>zh_CN</key>
                <string>用 7-Zip 压缩</string>
            </dict>
            <key>NSMessage</key>
            <string>compressWithSevenZip</string>
            <key>NSPortName</key>
            <string>7-Zip</string>
            <key>NSSendFileTypes</key>
            <array>
                <string>public.item</string>
            </array>
            <key>NSRequiredContext</key>
            <dict>
                <key>NSTextContent</key>
                <string>FilePath</string>
            </dict>
        </dict>

        <dict>
            <key>NSMenuItem</key>
            <dict>
                <key>default</key>
                <string>用 7-Zip 解压</string>
                <key>en</key>
                <string>Extract with 7-Zip</string>
                <key>zh-Hans</key>
                <string>用 7-Zip 解压</string>
                <key>zh_CN</key>
                <string>用 7-Zip 解压</string>
            </dict>
            <key>NSMessage</key>
            <string>extractWithSevenZip</string>
            <key>NSPortName</key>
            <string>7-Zip</string>
            <key>NSSendFileTypes</key>
            <array>
                <string>public.item</string>
            </array>
            <key>NSRequiredContext</key>
            <dict>
                <key>NSTextContent</key>
                <string>FilePath</string>
            </dict>
        </dict>

    </array>

</dict>
</plist>
