# ===========================================================================
# 7-Zip macOS port — ignore rules
#
# Principle: only sources, build scripts and documentation are versioned.
# Everything that a build can regenerate is excluded, so the repository stays
# small and every artifact is reproducible from a checkout.
# ===========================================================================

# --- macOS noise -----------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.fseventsd
.AppleDouble
.LSOverride
__MACOSX/

# Finder's custom-folder-icon file. Deliberately anchored to the repository
# root: the conventional unanchored glob "Icon?" would also match the upstream
# source directory 7z2603-src/CPP/7zip/Archive/Icons/ and silently drop the 27
# asset files inside it.
/Icon?

# --- local workspace data (session logs, internal notes) -------------------
.workbuddy/

# --- upstream 7-Zip source archives ---------------------------------------
# The unpacked tree 7z2603-src/ is vendored, so the archives are redundant.
# Re-download from https://github.com/ip7z/7zip/releases if you need them.
7z2603-src.7z
7z2603-src.tar.xz
7z2603-src.tar.bz2
7z2603-src.zip

# --- upstream build output ------------------------------------------------
# Upstream keeps compiler products in <target>/b/. One was produced locally
# while building the engine; it must never enter the repository.
7z2603-src/**/b/

# --- port: command line engine --------------------------------------------
dist/build/7zz

# --- port: embedded engine and bridge layer --------------------------------
# lib7z.dylib is the LGPL replaceable library and lib7zbridge*.a the glue the
# app links against. Both are rebuilt by `make dylib` / `make bridge` from the
# sources under dist/engine/, so only those sources are versioned. The symlink
# dist/lib/7z.dylib is a build-time convenience alias and equally derived.
dist/lib/

# --- port: engine build intermediates -------------------------------------
# Logs of the two architecture slices plus the per-slice object trees. Kept
# out of the repository because the upstream tree already carries b/, and a
# stale intermediate here is what makes an edit look like it had no effect.
dist/engine/.build/
dist/engine/.build_*.log

# --- port: test binaries ---------------------------------------------------
# verify_engine.sh and objc_test are produced by build_test.sh /
# build_objc_test.sh; verify_scripts.sh and verify_app.sh are the sources of
# truth and are versioned instead.
dist/tests/.build/
dist/tests/engine_test
dist/tests/objc_test

# --- port: installer work area and release artifacts ----------------------
# Release binaries are published as GitHub Release assets, not committed.
dist/build/.installer/
dist/build/.selfcheck/
dist/*.pkg
dist/*.dmg
dist/*.tar.gz
dist/*.tar.xz
dist/*.tar.gz.sha256

# --- port: staged payload trees (regenerated by package.sh / make_installer.sh)
dist/pack/
dist/payload/
dist/dmg-src/
dist/tar-src/

# --- port: compiled application and extension -----------------------------
dist/7-Zip.app/
dist/app-src/.build/
dist/ql-src/.build/

# --- editor / tooling ------------------------------------------------------
*~
*.swp
.idea/
.vscode/
